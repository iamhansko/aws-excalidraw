      "isDeleted": true,
      "boundElements": null,
      "updated": 1788604245766,
      "link": null,
      "locked": false,
      "text": "python3 -c \"\nimport boto3\nfrom botocore.auth import SigV4Auth\nfrom botocore.awsrequest import AWSRequest\n\nclient = boto3.client('sts')\nrequest = AWSRequest(method='POST', url='https://sts.ap-northeast-\n2.amazonaws.com', data={'Action': 'GetCallerIdentity', 'Version': '2011-06-\n15'})\nSigV4Auth(client._request_signer._credentials, 'sts',\nclient.meta.region_name).add_auth(request)\n\nimport urllib.parse\nprint(request.url + '?' + urllib.parse.urlencode(request.headers))\n\"",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "python3 -c \"\nimport boto3\nfrom botocore.auth import SigV4Auth\nfrom botocore.awsrequest import AWSRequest\n\nclient = boto3.client('sts')\nrequest = AWSRequest(method='POST', url='https://sts.ap-northeast-2.amazonaws.com', data={'Action': 'GetCallerIdentity', 'Version': '2011-06-15'})\nSigV4Auth(client._request_signer._credentials, 'sts', client.meta.region_name).add_auth(request)\n\nimport urllib.parse\nprint(request.url + '?' + urllib.parse.urlencode(request.headers))\n\"",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
