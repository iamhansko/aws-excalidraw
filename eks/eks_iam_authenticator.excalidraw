    {
      "id": "aS5kYMnB10mUKKmtt9cM7",
      "type": "text",
      "x": -932.9429295107473,
      "y": -459.0940535314187,
      "width": 362.6095707003259,
      "height": 400.809797439709,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "QjSvoOy74HyXKKdWcIjGS",
      "index": "bEQzzzzzzuK",
      "roundness": null,
      "seed": 529614377,
      "version": 1026,
      "versionNonce": 223686217,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788605665055,
      "link": null,
      "locked": false,
      "text": "export REGION=\"ap-northeast-2\"; \\\nexport EKS_CLUSTER_NAME=\"\"; \\\nexport EKS_API_SERVER_ENDPOINT=\"\";\nexport EKS_CERTIFICATE_AUTHORITY=\"\";\n\necho -e \"Region : $REGION\\n\nCluster : $EKS_CLUSTER_NAME\\n\nAPI Server : $EKS_API_SERVER_ENDPOINT\\n\nCA : $EKS_CERTIFICATE_AUTHORITY\\n\"\n\nexport PRESIGNED_URL=$(python3 -c \"\nimport boto3\nfrom botocore.signers import RequestSigner\n\nregion = '$REGION'\ncluster = '$EKS_CLUSTER_NAME'\nsession = boto3.session.Session()\nsts = session.client('sts', region_name=region)\nservice_id = sts.meta.service_model.service_id\n\nsigner = RequestSigner(service_id, region, 'sts', 'v4', session.get_credentials(), session.events)\nparams = {\n  'method': 'GET',\n  'url': 'https://sts.{}.amazonaws.com/?Action=GetCallerIdentity&Version=2011-06-15'.format(region),\n  'body': {},\n  'headers': {'x-k8s-aws-id': cluster},\n  'context': {}\n}\nsigned_url = signer.generate_presigned_url(params, region_name=region, expires_in=60, operation_name='')\nprint(signed_url)\n\")\n\necho \"$PRESIGNED_URL\" | sed 's/[?&]/\\\\\\n&/g'\n\n# curl -H \"x-k8s-aws-id: $EKS_CLUSTER\" $PRESIGNED_URL\n\nTOKEN=\"k8s-aws-v1.$(echo -n \"$PRESIGNED_URL\" | basenc --base64url -w 0 | tr -d '=')\"\necho \"$TOKEN\"\n\necho -e $EKS_CERTIFICATE_AUTHORITY | base64 --decode > /tmp/ca.crt\ncurl -X GET \\\n-H \"Authorization: Bearer $TOKEN\" \\\n--cacert /tmp/ca.crt \\\n$EKS_API_SERVER_ENDPOINT/api/v1/nodes \\\n| jq '.items[].metadata.name'",
      "fontSize": 7.1255075100392675,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "export REGION=\"ap-northeast-2\"; \\\nexport EKS_CLUSTER_NAME=\"\"; \\\nexport EKS_API_SERVER_ENDPOINT=\"\";\nexport EKS_CERTIFICATE_AUTHORITY=\"\";\n\necho -e \"Region : $REGION\\n\nCluster : $EKS_CLUSTER_NAME\\n\nAPI Server : $EKS_API_SERVER_ENDPOINT\\n\nCA : $EKS_CERTIFICATE_AUTHORITY\\n\"\n\nexport PRESIGNED_URL=$(python3 -c \"\nimport boto3\nfrom botocore.signers import RequestSigner\n\nregion = '$REGION'\ncluster = '$EKS_CLUSTER_NAME'\nsession = boto3.session.Session()\nsts = session.client('sts', region_name=region)\nservice_id = sts.meta.service_model.service_id\n\nsigner = RequestSigner(service_id, region, 'sts', 'v4', session.get_credentials(), session.events)\nparams = {\n  'method': 'GET',\n  'url': 'https://sts.{}.amazonaws.com/?Action=GetCallerIdentity&Version=2011-06-15'.format(region),\n  'body': {},\n  'headers': {'x-k8s-aws-id': cluster},\n  'context': {}\n}\nsigned_url = signer.generate_presigned_url(params, region_name=region, expires_in=60, operation_name='')\nprint(signed_url)\n\")\n\necho \"$PRESIGNED_URL\" | sed 's/[?&]/\\\\\\n&/g'\n\n# curl -H \"x-k8s-aws-id: $EKS_CLUSTER\" $PRESIGNED_URL\n\nTOKEN=\"k8s-aws-v1.$(echo -n \"$PRESIGNED_URL\" | basenc --base64url -w 0 | tr -d '=')\"\necho \"$TOKEN\"\n\necho -e $EKS_CERTIFICATE_AUTHORITY | base64 --decode > /tmp/ca.crt\ncurl -X GET \\\n-H \"Authorization: Bearer $TOKEN\" \\\n--cacert /tmp/ca.crt \\\n$EKS_API_SERVER_ENDPOINT/api/v1/nodes \\\n| jq '.items[].metadata.name'",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
