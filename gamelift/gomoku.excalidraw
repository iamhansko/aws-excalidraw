    {
      "id": "QE0l23nOcCYBFw81_mliH",
      "type": "text",
      "x": 53.202791241479474,
      "y": 1129.9873872180983,
      "width": 156.25551478442162,
      "height": 321.78023014328005,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "4SbYYWBFjvsz7i2-a23HU"
      ],
      "frameId": "swixWK0UwvJhImkuG3OgT",
      "index": "b6DGG",
      "roundness": null,
      "seed": 816741653,
      "version": 1799,
      "versionNonce": 807668411,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785546444175,
      "link": "https://docs.aws.amazon.com/ko_kr/gameliftservers/latest/flexmatchguide/match-examples-1.html",
      "locked": false,
      "text": "{\n  \"ruleLanguageVersion\": \"1.0\",\n  \"playerAttributes\": [\n    {\n      \"name\": \"score\",\n      \"type\": \"number\",\n      \"default\": 1000\n    }\n  ],\n  \"teams\": [\n    {\n      \"name\": \"blue\",\n      \"maxPlayers\": 1,\n      \"minPlayers\": 1\n    },\n    {\n      \"name\": \"red\",\n      \"maxPlayers\": 1,\n      \"minPlayers\": 1\n    }\n  ],\n  \"rules\": [\n    {\n      \"name\": \"EqualTeamSizes\",\n      \"type\": \"comparison\",\n      \"measurements\": [ \"count(teams[red].players)\" ],\n      \"referenceValue\": \"count(teams[blue].players)\",\n      \"operation\": \"=\"\n    },\n    {\n      \"name\": \"FairTeamSkill\",\n      \"type\": \"distance\",\n      \"measurements\": [ \"avg(teams[*].players.attributes[score])\" ],\n      \"referenceValue\": \"avg(flatten(teams[*].players.attributes[score]))\",\n      \"maxDistance\": 300\n    }\n  ],\n  \"expansions\": [\n    {\n      \"target\": \"rules[FairTeamSkill].maxDistance\",\n      \"steps\": [\n        {\n          \"waitTimeSeconds\": 10,\n          \"value\": 500\n        },\n        {\n          \"waitTimeSeconds\": 20,\n          \"value\": 800\n        },\n        {\n          \"waitTimeSeconds\": 30,\n          \"value\": 1000\n        }\n      ]\n    }\n  ]\n}\n",
      "fontSize": 4.438348001976277,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n  \"ruleLanguageVersion\": \"1.0\",\n  \"playerAttributes\": [\n    {\n      \"name\": \"score\",\n      \"type\": \"number\",\n      \"default\": 1000\n    }\n  ],\n  \"teams\": [\n    {\n      \"name\": \"blue\",\n      \"maxPlayers\": 1,\n      \"minPlayers\": 1\n    },\n    {\n      \"name\": \"red\",\n      \"maxPlayers\": 1,\n      \"minPlayers\": 1\n    }\n  ],\n  \"rules\": [\n    {\n      \"name\": \"EqualTeamSizes\",\n      \"type\": \"comparison\",\n      \"measurements\": [ \"count(teams[red].players)\" ],\n      \"referenceValue\": \"count(teams[blue].players)\",\n      \"operation\": \"=\"\n    },\n    {\n      \"name\": \"FairTeamSkill\",\n      \"type\": \"distance\",\n      \"measurements\": [ \"avg(teams[*].players.attributes[score])\" ],\n      \"referenceValue\": \"avg(flatten(teams[*].players.attributes[score]))\",\n      \"maxDistance\": 300\n    }\n  ],\n  \"expansions\": [\n    {\n      \"target\": \"rules[FairTeamSkill].maxDistance\",\n      \"steps\": [\n        {\n          \"waitTimeSeconds\": 10,\n          \"value\": 500\n        },\n        {\n          \"waitTimeSeconds\": 20,\n          \"value\": 800\n        },\n        {\n          \"waitTimeSeconds\": 30,\n          \"value\": 1000\n        }\n      ]\n    }\n  ]\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
