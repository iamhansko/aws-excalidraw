    {
      "id": "vjXDdIu0iWk2FrJNLcT_N",
      "type": "text",
      "x": 141.17035019779308,
      "y": 857.4941643624054,
      "width": 106.41032540092365,
      "height": 14.155273346176159,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "#d0bfff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "swixWK0UwvJhImkuG3OgT",
      "index": "b6EQ",
      "roundness": null,
      "seed": 2004258005,
      "version": 1164,
