      "link": null,
      "locked": false,
      "text": "NACL : WL(Default)+BL (Rule Number) - Subnet\nStateless (요청자의 IP+Port 저장 X)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NACL : WL(Default)+BL (Rule Number) - Subnet\nStateless (요청자의 IP+Port 저장 X)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1cl7eYXDnC-mnf1AH6RAa",
      "type": "text",
      "x": 1803.9123135403424,
      "y": 1319.4455008915802,
      "width": 546.3424421037948,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "j9LlSBPV5l89eTuPW6Q4B",
      "index": "b90t",
      "roundness": null,
      "seed": 329498049,
      "version": 1255,
      "versionNonce": 1307797423,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786356613963,
      "link": null,
      "locked": false,
      "text": "서브넷은 1 NACL, 1 라우팅 테이블을 선택해야 합니다. 서브넷\n생성 시 NACL, 라우팅 테이블을 지정하지 않으면 VPC 기본\nNACL, 기본 라우팅 테이블이 자동 연결됩니다.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "서브넷은 1 NACL, 1 라우팅 테이블을 선택해야 합니다. 서브넷 생성 시 NACL, 라우팅 테이블을 지정하지 않으면 VPC 기본 NACL, 기본 라우팅 테이블이 자동 연결됩니다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "j9LlSBPV5l89eTuPW6Q4B",
      "type": "frame",
      "x": 1353.869248877953,
      "y": 1150.0407404946736,
      "width": 1665.6250000000005,
      "height": 345,
      "angle": 0,
      "strokeColor": "#bbb",
