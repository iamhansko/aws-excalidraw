      "isDeleted": false,
      "boundElements": [],
      "updated": 1786356573074,
      "link": null,
      "locked": false,
      "text": "번거로운 운용 과정과 상면 임대료, 전원, 시스템 투자 등 인프라 전반의 운영비를 감안하면\n오히려 규모의 경제와 그 혜택을 누릴 수 있는 클라우드",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "번거로운 운용 과정과 상면 임대료, 전원, 시스템 투자 등 인프라 전반의 운영비를 감안하면\n오히려 규모의 경제와 그 혜택을 누릴 수 있는 클라우드",
      "autoResize": true,
      "lineHeight": 1.25
    },
