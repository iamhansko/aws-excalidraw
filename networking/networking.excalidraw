    },
    {
      "id": "bkT4zeJPDudMNvzQtOFPm",
      "type": "text",
      "x": 3098.342009747282,
      "y": -642.8841137495529,
      "width": 493.31982421875,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "2bnVPT2EHk4ziiE-Gw2bX",
      "index": "b91G",
      "roundness": null,
      "seed": 1377605922,
      "version": 1430,
      "versionNonce": 1032727393,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786356653472,
      "link": null,
      "locked": false,
      "text": "CIDR\n마스크(고정)비트 + 가변비트\n각 서브넷 CIDR 블록의 \n첫 4개 + 마지막 1개 IP 주소는 AWS 예약\n\n퍼블릭 CIDR 블록은 존재하지 않는다 -> 대신 탄력적 IP\n\n서브넷 : VPC 나누기 + ENI 담기\n\n퍼블릭 서브넷\n프라이빗 서브넷\n\n서브넷 -> 기본 라우팅테이블 + 기본 NACL\n\n1 Zonal NATGW == 1 ENI",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CIDR\n마스크(고정)비트 + 가변비트\n각 서브넷 CIDR 블록의 \n첫 4개 + 마지막 1개 IP 주소는 AWS 예약\n\n퍼블릭 CIDR 블록은 존재하지 않는다 -> 대신 탄력적 IP\n\n서브넷 : VPC 나누기 + ENI 담기\n\n퍼블릭 서브넷\n프라이빗 서브넷\n\n서브넷 -> 기본 라우팅테이블 + 기본 NACL\n\n1 Zonal NATGW == 1 ENI",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yfgox1eKIlVvCiYTBnUgb",
      "type": "text",
      "x": 3668.28591554462,
      "y": -633.5604372977898,
      "width": 779.1168474469864,
      "height": 150,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "2bnVPT2EHk4ziiE-Gw2bX",
      "index": "b91V",
      "roundness": null,
      "seed": 336456906,
      "version": 952,
      "versionNonce": 1246066479,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786356653472,
      "link": null,
      "locked": false,
      "text": "# NATGW (ENI(s) w/o Security Group)\nPublic NATGW : PrivateIP(s) -> IGW NAT Table -> PublicIP(EIP) -> Internet\nPrivate NATGW : PrivateIP(s) -> PrivateIP\n\n# IGW NAT Table\nEIP Association : PrivateIP <-> PublicIP Mapping 저장",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# NATGW (ENI(s) w/o Security Group)\nPublic NATGW : PrivateIP(s) -> IGW NAT Table -> PublicIP(EIP) -> Internet\nPrivate NATGW : PrivateIP(s) -> PrivateIP\n\n# IGW NAT Table\nEIP Association : PrivateIP <-> PublicIP Mapping 저장",
      "autoResize": false,
      "lineHeight": 1.25
    },
