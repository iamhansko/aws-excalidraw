      "updated": 1764919083498,
      "link": null,
      "locked": false,
      "text": "\n{\n    \"Version\": \"2012-10-17\",                                   \n    \"Statement\": [\n        {\n            \"Sid\": \"CTS3PV3\",\n            \"Effect\": \"Deny\",\n            \"Principal\": \"*\",\n            \"Action\": \"s3:*\",\n            \"Resource\": \"*\",\n            \"Condition\": {\n                \"NumericLessThan\": {\n                    \"s3:TlsVersion\": \"1.3\"\n                }{% if ExemptedPrincipalArns %},\n                \"ArnNotLike\": {\n                    \"aws:PrincipalArn\": {{ExemptedPrincipalArns}}\n                }{% endif %}\n            }\n        }\n    ]\n}\n    ",
      "fontSize": 7.03636363636363,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n{\n    \"Version\": \"2012-10-17\",                                   \n    \"Statement\": [\n        {\n            \"Sid\": \"CTS3PV3\",\n            \"Effect\": \"Deny\",\n            \"Principal\": \"*\",\n            \"Action\": \"s3:*\",\n            \"Resource\": \"*\",\n            \"Condition\": {\n                \"NumericLessThan\": {\n                    \"s3:TlsVersion\": \"1.3\"\n                }{% if ExemptedPrincipalArns %},\n                \"ArnNotLike\": {\n                    \"aws:PrincipalArn\": {{ExemptedPrincipalArns}}\n                }{% endif %}\n            }\n        }\n    ]\n}\n    ",
