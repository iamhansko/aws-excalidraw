      "seed": 2052750584,
      "version": 781,
      "versionNonce": 2010009736,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752396815928,
      "link": null,
      "locked": false,
      "text": "User \n-> Internet-facing NLB (Hub VPC) \"gj2025-app-external-nlb\"\n-> Internal NLB \"gj2025-app-internal-nlb\"\n-> Internal ALB \"gj2025-app-alb\"\n-> Green/Red App",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User \n-> Internet-facing NLB (Hub VPC) \"gj2025-app-external-nlb\"\n-> Internal NLB \"gj2025-app-internal-nlb\"\n-> Internal ALB \"gj2025-app-alb\"\n-> Green/Red App",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "AUpwmYQk3W8cWaAzEpABf",
      "type": "text",
      "x": 1895.0890264930254,
      "y": 42.186117046253344,
      "width": 443.6316223144531,
      "height": 200,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "K1AjLeo80CORdSynxl3tV",
      "index": "c2Qh",
      "roundness": null,
      "seed": 1854603256,
      "version": 589,
      "versionNonce": 1603575032,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752396815928,
      "link": null,
      "locked": false,
      "text": "Fluentbit Daemonset \"red-fluent-bit\", \"green-fluent-bit\"\n-> (3초 내) -> CloudWatch LogGroup\nHTTP 로그만 전송, /health 경로 로그는 제외\nNamespace \"amazon-cloudwatch\"\n- Green Application Log Group Name : /gj2025/app/green\n- Green Application Log Stream Name : app-green-logs\n- Red Application Log Group Name: /gj2025/app/red\n- Red Application Log Stream Name: app-red-logs\n- CodeBuild Red Log Group Name: /gj2025/build/red\n- CodeBuild Green Log Group Name: /gj2025/build/green",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fluentbit Daemonset \"red-fluent-bit\", \"green-fluent-bit\"\n-> (3초 내) -> CloudWatch LogGroup\nHTTP 로그만 전송, /health 경로 로그는 제외\nNamespace \"amazon-cloudwatch\"\n- Green Application Log Group Name : /gj2025/app/green\n- Green Application Log Stream Name : app-green-logs\n- Red Application Log Group Name: /gj2025/app/red\n- Red Application Log Stream Name: app-red-logs\n- CodeBuild Red Log Group Name: /gj2025/build/red\n- CodeBuild Green Log Group Name: /gj2025/build/green",
      "autoResize": true,
      "lineHeight": 1.25
    },
