    {
      "id": "men8b0ntCHk0-tTraT_aV",
      "type": "text",
      "x": 1817.1024135584357,
      "y": -602.0651925037869,
      "width": 518.383544921875,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
