    {
      "id": "9ZokMtC2BraMVqDQXNU4z",
      "type": "text",
      "x": 190.47222222222263,
      "y": 404.41270858522466,
      "width": 506.57568359375,
      "height": 120,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "PHWAHMLGgHirxOZqaAY8b",
      "index": "c2VQl",
      "roundness": null,
      "seed": 1525400712,
      "version": 266,
      "versionNonce": 539309704,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752390499019,
      "link": null,
      "locked": false,
      "text": "VPC Endpoint를 활용하여 S3 객체 Application VPC만을 거쳐 다운로드\n2 VPC 내 모든 트래픽 CloudWatch 로그 그룹에 저장\n  ❍ ws25-hub-vpc : /ws25/flow/hub\n  ❍ ws25-app-vpc : /ws25/flow/app\nBastionEC2가 배치될 퍼블릭 서브넷에서 RDS 접근 가능하도록\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "VPC Endpoint를 활용하여 S3 객체 Application VPC만을 거쳐 다운로드\n2 VPC 내 모든 트래픽 CloudWatch 로그 그룹에 저장\n  ❍ ws25-hub-vpc : /ws25/flow/hub\n  ❍ ws25-app-vpc : /ws25/flow/app\nBastionEC2가 배치될 퍼블릭 서브넷에서 RDS 접근 가능하도록\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hiOKtqoVl8YapULqZFBfR",
      "type": "text",
      "x": 311.4722222222226,
      "y": 543.0793345617872,
      "width": 236.49586486816406,
      "height": 40,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "PHWAHMLGgHirxOZqaAY8b",
      "index": "c2VQx",
      "roundness": null,
      "seed": 262781320,
      "version": 220,
      "versionNonce": 1515005320,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752390499019,
      "link": null,
      "locked": false,
      "text": "인스턴스 종료(삭제) 시 \n인스턴스가 종료되어서는 안됩니다.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "인스턴스 종료(삭제) 시 \n인스턴스가 종료되어서는 안됩니다.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "X1GP0X2jEPwEQnQfek0PE",
      "type": "text",
      "x": 934.4654149028293,
      "y": 1024.7808164848916,
      "width": 152.22390747070312,
      "height": 120,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "PHWAHMLGgHirxOZqaAY8b",
      "index": "c2VQz",
      "roundness": null,
      "seed": 1481432456,
      "version": 305,
      "versionNonce": 413652728,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752390499019,
      "link": null,
      "locked": false,
      "text": "Golang Applications\nGreen TCP/8080\n\nRed TCP/8080\nv1.0.0 -> v1.0.1\n-h 바이너리 실행 도움",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Golang Applications\nGreen TCP/8080\n\nRed TCP/8080\nv1.0.0 -> v1.0.1\n-h 바이너리 실행 도움",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CU3rsPX_AhBBRM4R-w5Oz",
      "type": "image",
      "x": 621.175530653386,
      "y": 519.7458995031934,
      "width": 283.9754535752401,
      "height": 364.99999999999994,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
